<Page
    x:Class="CreaVITy.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="20">
            <!-- Header -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Canvas preferences, rendering fidelity, and app theme" Opacity="0.7" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Canvas Appearance Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Canvas Appearance" FontSize="16" FontWeight="SemiBold" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Grid Pattern" FontWeight="Medium" />
                            <TextBlock Text="Background paper grid for alignment" Opacity="0.6" FontSize="12" />
                        </StackPanel>
                        <ComboBox x:Name="GridTypeCombo" Grid.Column="1" SelectedIndex="0" SelectionChanged="GridTypeCombo_SelectionChanged">
                            <ComboBoxItem Content="Plain Blank" />
                            <ComboBoxItem Content="Dot Grid" />
                            <ComboBoxItem Content="Square Grid" />
                            <ComboBoxItem Content="Ruled Lines" />
                        </ComboBox>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dark Background" FontWeight="Medium" />
                            <TextBlock Text="Switch canvas background to dark blackboard" Opacity="0.6" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DarkThemeToggle" Grid.Column="1" Toggled="DarkThemeToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Stroke & Smoothing Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Drawing &amp; Smoothing" FontSize="16" FontWeight="SemiBold" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Laplacian Path Smoothing" FontWeight="Medium" />
                            <TextBlock Text="Remove hand jitters from pen strokes in real-time" Opacity="0.6" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SmoothingToggle" Grid.Column="1" IsOn="True" Toggled="SmoothingToggle_Toggled" />
                    </Grid>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Default Stroke Width" FontWeight="Medium" />
                        <Slider x:Name="StrokeWidthSlider" Minimum="1" Maximum="32" Value="4" ValueChanged="StrokeWidthSlider_ValueChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
