<Page
    x:Class="CreaVITy.Windows.Views.PeerConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Peer Collaboration Mesh" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Cross-platform real-time collaboration with Android &amp; Windows over local Wi-Fi / Hotspot"
                           Opacity="0.7" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status & Control Card -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock x:Name="DeviceNameText" Text="🎨 Windows PC" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="SessionStatusText" Text="Status: Standalone" Opacity="0.7" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="HostButton" Content="Host Session" Style="{ThemeResource AccentButtonStyle}" Click="HostButton_Click" />
                        <Button x:Name="ScanButton" Content="Find Peers" Click="ScanButton_Click" />
                    </StackPanel>

                    <!-- Room Code Badge -->
                    <Border x:Name="RoomCodeBadge" Grid.Row="1" Grid.ColumnSpan="2"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            CornerRadius="6" Padding="12,8" Margin="0,16,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Active Room Code:" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock x:Name="RoomCodeText" Text="-----" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Connected Peers Section -->
            <StackPanel x:Name="ConnectedSection" Grid.Row="2" Margin="0,0,0,24" Visibility="Collapsed">
                <TextBlock Text="Connected Peers" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <ListView x:Name="ConnectedListView" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F4;" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding EndpointId}" Opacity="0.5" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Disconnect" Tag="{Binding EndpointId}" Click="DisconnectPeer_Click" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Discovered Peers Section -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Discovered Peers on Network" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                <!-- Empty State -->
                <StackPanel x:Name="EmptyPeersNotice" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32" Spacing="8">
                    <FontIcon Glyph="&#xE753;" FontSize="36" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Text="No peers discovered yet" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                    <TextBlock Text="Tap 'Find Peers' or 'Host Session'. Ensure devices share the same Wi-Fi / Hotspot."
                               Opacity="0.6" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
                </StackPanel>

                <!-- Discovered Peers ListView -->
                <ListView x:Name="DiscoveredListView" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F4;" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding EndpointId}" Opacity="0.6" FontSize="12" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Connect" Style="{ThemeResource AccentButtonStyle}" Tag="{Binding EndpointId}" Click="ConnectPeer_Click" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
