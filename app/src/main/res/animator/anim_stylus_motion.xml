    <objectAnimator
        android:startOffset="1530"
        android:duration="120"
        android:interpolator="@interpolator/playful_draw_interpolator"
        android:propertyName="rotation"
        android:valueFrom="-13.0"
        android:valueTo="-19.23"
        android:valueType="floatType" />
</set>
