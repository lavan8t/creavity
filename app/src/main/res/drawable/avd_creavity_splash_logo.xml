<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/vd_creavity_splash_logo">

    <!-- Animate stroke line drawing -->
    <target
        android:name="stroke_path"
        android:animation="@animator/anim_logo_stroke_draw" />

    <!-- Animate full stylus motion along the stroke path -->
    <target
        android:name="stylus_group"
        android:animation="@animator/anim_stylus_motion" />
</animated-vector>
